# 环境变量（复制为 .env 并填写实际值）

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# PMS 数据库
PMS_DB_URL=mysql://username:password@localhost:3306/hotel_pms

# 支付网关
PAYMENT_GATEWAY_URL=https://pay.example.com/api
PAYMENT_GATEWAY_KEY=your-payment-gateway-key

# 发票系统
INVOICE_SYSTEM_URL=https://inv.example.com/api

# 酒店信息
HOTEL_CODE=HTL001
HOTEL_NAME=示例大酒店
